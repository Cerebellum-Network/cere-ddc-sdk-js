{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "#descriptors": ["packages/blockchain/.papi/descriptors/dist/index.d.ts"]
    },
    "outDir": "dist",
    "target": "esnext",
    "module": "esnext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "moduleResolution": "node",
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true
  },
  "include": ["packages/", "tests/"],
  "exclude": ["node_modules", "dist", "package", "**/dist/**"]
}
