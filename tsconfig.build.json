{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "#descriptors": ["packages/blockchain/.papi/descriptors/dist/index.d.ts"],
      "#ws-provider": ["packages/blockchain/src/papi/ws-provider.ts"],
      "@cere-ddc-sdk/blockchain/papi": ["packages/blockchain/dist/types/papi/index.d.ts"]
    },
    "outDir": "dist",
    "target": "esnext",
    "module": "esnext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "moduleResolution": "node",
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true
  },
  "include": ["packages/", "tests/"],
  "exclude": ["node_modules", "dist", "package", "**/dist/**"]
}
