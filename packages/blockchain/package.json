on
{
  "name": "@cere-ddc-sdk/blockchain",
  "version": "3.0.1",
  "description": "Cere Blockchain client",
  "type": "module",
  "main": "./dist/papi/index.js",
  "types": "./dist/types/papi/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/papi/index.d.ts",
      "default": "./dist/papi/index.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#descriptors": {
      "types": "./.papi/descriptors/dist/index.d.ts",
      "default": "./.papi/descriptors/dist/index.js"
    },
    "#ws-provider": {
      "types": "./dist/types/papi/ws-provider.d.ts",
      "browser": "./dist/papi/ws-provider.web.js",
      "default": "./dist/papi/ws-provider.js"
    }
  },
  "files": [
    "dist",
    ".papi",
    "package"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "directory": "packages/blockchain",
    "url": "git+https://github.com/Cerebellum-Network/cere-ddc-sdk-js.git"
  },
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.papi.json",
    "package": "clean-publish",
    "clean": "rimraf dist package",
    "docs": "typedoc",
    "generate": "papi generate",
    "prepare": "papi generate && node scripts/ensure-publishable-descriptors.mjs",
    "build:abi": "node scripts/gen-abi.mjs"
  },
  "author": "Cere Network <contact@cere.io (https://www.cere.io/)",
  "license": "Apache-2.0",
  "dependencies": {
    "@polkadot-api/ink-contracts": "^0.6.3",
    "@polkadot-api/substrate-bindings": "^0.20.3",
    "@polkadot-api/ws-provider": "^0.9.0",
    "@polkadot-labs/hdkd": "^0.0.29",
    "@polkadot-labs/hdkd-helpers": "^0.0.31",
    "@polkadot/keyring": "^13.3.1",
    "@polkadot/util-crypto": "^13.5.7",

  }
}