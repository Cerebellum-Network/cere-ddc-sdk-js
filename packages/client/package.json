{
  "name": "@cere-ddc-sdk/client",
  "description": "Cere Client SDK",
  "version": "0.0.3",
  "type": "module",
  "repository": {
    "type": "git",
    "directory": "packages/client",
    "url": "git+https://github.com/Cerebellum-Network/cere-ddc-sdk-js.git"
  },
  "main": "dist/index.cjs",
  "types": "dist/types/index.d.ts",
  "module": "dist/index.js",
  "exports": {
    "types": "./dist/types/index.d.ts",
    "require": "./dist/index.cjs",
    "browser": "./dist/browser.js",
    "default": "./dist/index.js"
  },
  "author": "Cere Network <contact@cere.io (https://www.cere.io/)",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npm-run-all --parallel build:node build:web",
    "build:node": "microbundle --tsconfig tsconfig.build.json --format esm,cjs --target node",
    "build:web": "microbundle --tsconfig tsconfig.build.json --format modern --output dist/browser.js",
    "package": "clean-publish",
    "clean": "rimraf dist package"
  },
  "dependencies": {
    "@cere-activity-sdk/ciphers": "0.1.7",
    "@cere-activity-sdk/signers": "0.1.7",
    "@cere/embed-wallet": "^0.23.0",
    "@fails-components/webtransport": "^1.4.8",
    "@fails-components/webtransport-transport-http3-quiche": "^1.4.8",
    "@polkadot/util": "^10.4.2",
    "@polkadot/util-crypto": "^10.4.2",
    "blakejs": "^1.2.1",
    "cross-fetch": "^4.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/uuid": "^9.0.8"
  }
}
